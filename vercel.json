{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "firebase-applet-config.json",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/src/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/logo-ivy-oliveira.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/__/auth/(.*)", "destination": "https://augmented-cedar-fbpf3.firebaseapp.com/__/auth/$1" },
    { "source": "/__/firebase/init.json", "destination": "https://augmented-cedar-fbpf3.firebaseapp.com/__/firebase/init.json" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|__/|assets/|src/|uploads/|logo-ivy-oliveira\\.png|favicon\\.ico|robots\\.txt|sitemap\\.xml).*)", "destination": "/index.html" }
  ]
}
